# pi5-scam — шаблон переменных окружения
# Скопируйте в .env и при необходимости измените: cp .env.example .env

# --- Сеть ---
HOST=0.0.0.0
PORT=8001
# --- Камера ---
# Индекс камеры (IMX219 на cam0 = 0; проверить: rpicam-hello --list-cameras)
CAMERA_NUM=0

# --- Живой поток (MJPEG) ---
# Разрешение потока (также меняется из веб-интерфейса и сохраняется сюда)
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FRAMERATE=30
# Качество JPEG кадров потока (1-95)
JPEG_QUALITY=70

# --- Фото ---
# Разрешение снимков (также меняется из веб-интерфейса и сохраняется сюда)
PHOTO_WIDTH=3280
PHOTO_HEIGHT=2464

# --- Хранилище снимков ---
PHOTO_DIR=photos

# --- Прочее ---
# Режим отладки Flask (true/false)
DEBUG=false
